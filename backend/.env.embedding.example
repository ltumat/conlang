# Copy this file to backend/.env.embedding and fill in private values.
EMBEDDING_MODEL=your-huggingface-model-id
MODAL_HF_SECRET_NAME=your-modal-huggingface-secret
MODAL_VOLUME_NAME=your-modal-volume

# Local source files used by the Modal entrypoint.
FRENCH_TEI_FILE=/path/to/your/french_dictionary.tei
FRENCH_SENTENCES_FILE=/path/to/your/sentence_pairs.tsv
FRENCH_LEXIQUE_FILE=/path/to/your/Lexique4.tsv
